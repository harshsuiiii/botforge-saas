# =============================================================
# BotForge – Environment Variables
# Copy this file to .env and fill in every value.
# NEVER commit .env to version control.
# =============================================================

# ─── Database ─────────────────────────────────────────────────
# Full Postgres connection string (Postgres 15+)
DATABASE_URL=postgres://user:password@localhost:5432/botforge

# ─── JWT ──────────────────────────────────────────────────────
# At least 32 random bytes, base64 or hex encoded.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_64_char_hex_string

# ─── Google OAuth 2.0 ─────────────────────────────────────────
# Create credentials at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Must match an Authorised Redirect URI in the Google console
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# ─── OpenAI ───────────────────────────────────────────────────
# No server setting needed: each bot owner pastes their own OpenAI API key
# in onboarding or Settings. Keys are stored encrypted (see below).

# ─── Token Encryption ─────────────────────────────────────────
# AES-256-GCM key used to encrypt stored OpenAI API keys.
# MUST be exactly 64 hex characters (= 32 bytes).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=replace_with_64_char_hex_string

# ─── App ──────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# Front-end origin (used for CORS and post-auth redirects)
FRONTEND_URL=http://localhost:5173

# Local development only: show "Continue as dev user" on the login page so the
# dashboard works before Google OAuth is set up. Ignored when NODE_ENV=production
# and only accepted from localhost.
DEV_LOGIN=false
